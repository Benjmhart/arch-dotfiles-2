# NOTE: until 2026-10-04 this lived under ~/.configure (the old XDG_CONFIG_HOME),
# and an fcitx5 started without that variable read an empty ~/.config/fcitx5 and
# fell back to stock defaults (no mozc, Ctrl+space, romaji). It is in ~/.config now,
# the default, so that trap is gone; .xinitrc still states the variable.

[Hotkey/TriggerKeys]
# Super+` -- Ben's request, 2026-08-25. Verified by synthesising the keypress
# with xdotool and reading CurrentInputMethod back over D-Bus, after proving
# the same harness flipped the old Alt+` binding (a negative result from an
# untested harness proves nothing).
#
# CORRECTION, and it matters because it blocked this for two weeks: the note
# here used to say "Super+<key> is doubly unusable: Super is the xmonad mod
# key, so xmonad grabs those combos at the X server." That is WRONG as a
# general claim. XMonad grabs only the combos actually present in its keymap,
# not the whole Super space, and there is no xK_grave binding anywhere in
# ~/.xmonad/xmonad.hs -- so Super+` was never taken. The real finding, which
# still holds, is the other half: modifier+LETTER triggers silently never
# match here (Alt+j, Alt+i, Super+i all verified dead); modifier+punctuation
# matches fine. "Super+i is dead" got generalised into "Super is dead", and
# the wrong half of the lesson stuck.
#
# Before adding any Super binding to xmonad.hs, check it is not this one.
#
# Also check fcitx5's OWN add-ons. Quick Phrase defaults to Super+grave too and
# took the key first (seen 2026-10-01: Super+` opened Quick Phrase instead of
# hiragana). conf/quickphrase.conf moves it off. Read the live keys with:
#   dbus-send --session --print-reply --dest=org.fcitx.Fcitx5 /controller \
#     org.fcitx.Fcitx.Controller1.GetConfig string:fcitx://config/addon/<name>
0=Super+grave
# fcitx5's documented default, verified working here; kept as a fallback.
1=Control+space

[Hotkey]
EnumerateWithTriggerKeys=True
