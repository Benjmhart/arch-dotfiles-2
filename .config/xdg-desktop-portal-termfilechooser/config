; File chooser for apps that ask the portal (Vivaldi, Chromium, Rambox): yazi in Alacritty.
; Routed by ~/.config/xdg-desktop-portal/portals.conf (FileChooser=termfilechooser).
; titled-yazi-wrapper.sh (beside this file) sets TERMCMD: the class lets xmonad float it
; (myManageHook), and the title ("Save as: <name>") shows in xmobar. station-maintenance beast-arch task 72.
[filechooser]
cmd=titled-yazi-wrapper.sh
default_dir=$HOME
open_mode=suggested
save_mode=suggested
