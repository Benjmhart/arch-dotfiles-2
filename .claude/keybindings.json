{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "enter": "chat:newline",
        "alt+enter": "chat:submit",
        "shift+enter": "chat:submit",
        "ctrl+enter": "chat:submit"
      }
    },
    {
      "context": "Global",
      "bindings": {
        "ctrl+up": null,
        "ctrl+down": null
      }
    },
    {
      "context": "Scroll",
      "bindings": {
        "ctrl+up": "scroll:pageUp",
        "ctrl+down": "scroll:pageDown"
      }
    },
    {
      "context": "Transcript",
      "bindings": {
        "ctrl+up": "scroll:fullPageUp",
        "ctrl+down": "scroll:fullPageDown"
      }
    }
  ]
}
