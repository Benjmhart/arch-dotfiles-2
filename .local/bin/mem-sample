#!/usr/bin/env python3
"""
mem-sample — record memory pressure over time on beast-arch.

WHY THIS EXISTS
  beast-arch task 51. The box has livelocked three times (2026-08-11, 08-12,
  08-15) and every post-mortem started blind: nothing on this machine records
  RSS over time, so "was it memory?" could only be answered for 08-12, where
  the kernel happened to log an OOM dump before dying. On 08-11 and 08-15 the
  journal simply stops and there is nothing to read.

  This writes a small fixed-width sample every 30s so the next event has a
  before-picture instead of a void.

WHY IT fsync()s EVERY LINE
  This is task 1's lesson applied. journald's 5-minute default flush meant the
  2026-08-11 lock-up took the last minutes of kernel log with it, which is why
  /etc/systemd/journald.conf.d/sync.conf now sets SyncIntervalSec=10s. A
  sampler whose whole job is to survive a freeze must not sit in the page
  cache. Each sample is flushed and fsync'd; the cost is one small write per
  30s, which is nothing next to losing the window again.

WHY NOT /tmp
  /tmp is tmpfs on this box — RAM (task 54). A memory-pressure log that lives
  in memory disappears exactly when memory is the problem, and counts against
  the thing being measured. Samples go to ~/.local/state/mem-sample/.

CAVEAT
  This is an INSTRUMENT, not a guard. It records; it does not act. It cannot
  prevent a livelock and it will itself be starved during one — the last line
  before a gap is the evidence, not a complete trace. A userspace OOM guard
  (earlyoom/nohang, task 51 item 1) is the thing that acts, and is still not
  installed.

  It also cannot protect itself: lowering its own OOM score needs
  CAP_SYS_RESOURCE, which a user unit does not have.

WHY THE TIMESTAMPS ARE UTC — added 2026-09-11
  Both the line stamp and the log FILENAME come from UTC, not local time.
  Naive local timestamps were the original scheme and they are monotonic only
  for as long as the local clock is. Two things break that, and one of them
  already did:

    * carbon's timezone changed from UTC to America/Toronto on 2026-09-11 at
      02:32 UTC. The local clock jumped BACKWARDS four hours, so the sampler
      reopened the previous day's file and appended 22:33:08 underneath an
      existing 23:59:56. The day's samples ended up split across two files
      interleaved in real time.
    * DST fall-back does the same thing every year, on BOTH machines. Checked
      against the zone database rather than assumed: America/Toronto next falls
      back 2026-11-01, 02:00 EDT -> 01:00 EST, so that hour would be logged
      twice with descending timestamps.

  The damage is not the ugly file. It is that report()'s gap detector computes
  t - prev across the discontinuity as NEGATIVE, which is not "> 3 minutes", so
  a REAL gap in coverage reads as no gap at all. On carbon 2026-09-11 that hid
  a genuine 2h33m hole in the samples — in the one tool built to find holes.

  UTC has no such discontinuity: no DST, no relocation, and the two machines'
  logs become directly comparable, which they were not while beast-arch ran
  Canada/Eastern and carbon ran UTC.

  Lines written before this change carry NAIVE local timestamps. report()
  attaches the machine's current zone to those rather than refusing to compare
  them — deltas BETWEEN two old lines stay exact, because a uniform offset
  cancels. Only the single boundary delta where naive meets aware is wrong, and
  that boundary is a real discontinuity anyway.

USAGE
  mem-sample              write one sample
  mem-sample --report     summarise today, worst-first
  mem-sample --prune N    delete logs older than N days (default 14)
"""
import argparse
import os
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

STATE = Path.home() / ".local/state/mem-sample"
TOP_N = 5


def meminfo():
    d = {}
    with open("/proc/meminfo") as fh:
        for line in fh:
            k, _, v = line.partition(":")
            d[k] = int(v.split()[0])  # kB
    return d


def top_rss(n):
    procs = []
    for p in Path("/proc").iterdir():
        if not p.name.isdigit():
            continue
        try:
            rss = int((p / "statm").read_text().split()[1]) * (os.sysconf("SC_PAGE_SIZE") // 1024)
            if rss < 51200:  # ignore anything under 50 MiB; the noise floor is ~70 processes
                continue
            comm = (p / "comm").read_text().strip()
            procs.append((rss, comm))
        except (OSError, ValueError, IndexError):
            continue  # process exited mid-read; expected, not an error
    procs.sort(reverse=True)
    return procs[:n]


def sample():
    m = meminfo()
    used = m["MemTotal"] - m["MemAvailable"]
    swap_used = m["SwapTotal"] - m["SwapFree"]
    fields = [
        datetime.now(timezone.utc).isoformat(timespec="seconds"),
        f"used={used // 1024}M",
        f"avail={m['MemAvailable'] // 1024}M",
        f"swap={swap_used // 1024}M",
        f"shmem={m['Shmem'] // 1024}M",          # tmpfs incl. /tmp and /dev/shm — task 54
        f"dirty={m['Dirty'] // 1024}M",
    ]
    fields += [f"{c}:{r // 1024}M" for r, c in top_rss(TOP_N)]
    line = " ".join(fields) + "\n"

    STATE.mkdir(parents=True, exist_ok=True)
    path = STATE / f"{datetime.now(timezone.utc):%Y-%m-%d}.log"
    with open(path, "a") as fh:
        fh.write(line)
        fh.flush()
        os.fsync(fh.fileno())   # see WHY IT fsync()s EVERY LINE
    return line


def report():
    # "Today" is the UTC day, matching how sample() names the file. On a machine
    # west of Greenwich the current UTC day starts during the previous local
    # evening; that is the cost of a monotonic clock and it is the right trade
    # for an instrument that measures elapsed time rather than calendar days.
    path = STATE / f"{datetime.now(timezone.utc):%Y-%m-%d}.log"
    if not path.exists():
        print(f"no samples yet for today, UTC ({path})")
        return 1
    lines = path.read_text().splitlines()
    print(f"{len(lines)} samples in {path}")

    def used_of(l):
        for f in l.split():
            if f.startswith("used="):
                return int(f[5:-1])
        return -1

    worst = max(lines, key=used_of)
    print(f"\npeak used:  {worst}")
    print(f"latest:     {lines[-1]}")

    # a gap much larger than the timer interval is the signature worth seeing
    print("\ngaps > 3 min (a freeze looks like this):")
    found = False
    prev = None
    for l in lines:
        try:
            t = datetime.fromisoformat(l.split()[0])
        except (ValueError, IndexError):
            continue
        # Pre-2026-09-11 lines are naive local. Mixing naive and aware in a
        # subtraction raises TypeError, which would take out the whole report
        # for any file that straddles the change -- so normalise rather than
        # crash. astimezone() on a naive value assumes this machine's zone,
        # which reproduces the old reading exactly for old lines.
        if t.tzinfo is None:
            t = t.astimezone()
        if prev and t < prev:
            # A backwards step is not a gap, and it must not be silent. It means
            # the clock moved under the sampler -- a timezone change or DST
            # fall-back -- and the delta ACROSS this point is meaningless, which
            # is precisely how a real 2h33m hole in carbon's samples read as "no
            # gaps" on 2026-09-11. Whatever gap is hiding here cannot be
            # measured from the timestamps; say so instead of scoring it zero.
            print(f"  {prev.isoformat()} -> {t.isoformat()}  CLOCK WENT BACKWARDS "
                  f"by {prev - t} -- any gap across this point is UNMEASURABLE")
            found = True
        elif prev and (t - prev) > timedelta(minutes=3):
            print(f"  {prev.time()} -> {t.time()}  ({t - prev})")
            found = True
        prev = t
    if not found:
        print("  none")
    return 0


def prune(days):
    cutoff = time.time() - days * 86400
    n = 0
    for f in STATE.glob("*.log"):
        if f.stat().st_mtime < cutoff:
            f.unlink()
            n += 1
    print(f"pruned {n} log(s) older than {days}d")
    return 0


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--report", action="store_true")
    ap.add_argument("--prune", type=int, nargs="?", const=14, metavar="DAYS")
    a = ap.parse_args()
    if a.report:
        sys.exit(report())
    if a.prune is not None:
        sys.exit(prune(a.prune))
    sys.stdout.write(sample())
