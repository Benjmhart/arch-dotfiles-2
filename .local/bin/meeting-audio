#!/usr/bin/env bash
#
# meeting-audio — give an ALSA-only capture client both halves of a call.
#
# WHY THIS EXISTS
#   cpal, the Rust audio library behind Meetily's Tauri frontend (and other
#   Tauri apps), has only an ALSA host on Linux. PipeWire's .monitor sources are
#   invisible through the ALSA bridge — `arecord -L` lists no device whose name
#   contains "monitor" — so Meetily's system-audio matcher
#   (frontend/src-tauri/src/audio/devices/platform/linux.rs, which selects on
#   name.contains("monitor")) can never match. Meetily then logs
#   "Mic: None, System: None" and records ALSA `default`: the microphone alone.
#   Your voice is transcribed, the far end is silently missing.
#
#   The workaround is to let the client open `default`, then move its stream.
#   Verified on beast-arch 2026-08-11: a client moved with
#   `pactl move-source-output` captured a 440 Hz test tone at -24.1 dBFS,
#   identical to native `pw-record --target`, i.e. full-strength system audio.
#
# WHAT IT DELIBERATELY DOES NOT DO
#   1. It never changes the global default source. That also works, but it makes
#      the browser transmit the mix — far end included — back into the call as
#      your microphone, and it hijacks Handy's dictation input.
#   2. It never moves a capture stream you did not name. On a Zoom or Meet call,
#      the conferencing app has its own microphone stream; moving THAT onto the
#      mix would feed the far end back to itself. Hence the mandatory pattern.
#
# CAVEAT
#   Everything playing to the captured sink is recorded, not just the call.
#
set -euo pipefail

SINK_NAME=meetingmix
STATE="${XDG_RUNTIME_DIR:-/tmp}/meeting-audio.state"
WATCHPID="${XDG_RUNTIME_DIR:-/tmp}/meeting-audio.watch.pid"

die() { printf 'meeting-audio: %s\n' "$1" >&2; exit 1; }

require_up() { [ -f "$STATE" ] || die "not up — run 'meeting-audio up' first"; }

# Index of the mix's monitor source. `.source` in pactl's JSON is a numeric
# index, not a name, so comparisons must be numeric or nothing ever matches.
mix_source_index() {
    pactl list short sources | awk -v n="$SINK_NAME.monitor" '$2 == n { print $1; exit }'
}

# Print the indexes of capture streams matching $1, excluding our own loopbacks
# and anything already sitting on the mix.
matching_streams() {
    local pattern="$1" mods mix
    mods=$(paste -sd, "$STATE")
    mix=$(mix_source_index)
    pactl -f json list source-outputs | jq -r \
        --arg mods "$mods" --arg pat "$pattern" --argjson mix "${mix:--1}" '
        ($mods | split(",") | map(tonumber)) as $ours
        | .[]
        | select((.owner_module // -1 | tonumber) as $m | ($ours | index($m)) | not)
        | select((.source | tonumber) != $mix)
        | select(((.properties["application.name"] // "") + " " +
                  (.properties["application.process.binary"] // "") + " " +
                  (.properties["media.name"] // ""))
                 | ascii_downcase | contains($pat | ascii_downcase))
        | .index'
}

list_candidates() {
    printf 'live capture streams:\n' >&2
    pactl -f json list source-outputs | jq -r '
        .[] | "  #\(.index)  source=\(.source)  app=\(.properties["application.name"] // "?")"' >&2
}

cmd_up() {
    [ -f "$STATE" ] && die "already up (state: $STATE) — run 'meeting-audio down' first"
    command -v pactl >/dev/null || die "pactl not found"
    command -v jq >/dev/null || die "jq not found"

    local sink mic
    sink="${MEETING_SINK:-$(pactl get-default-sink)}"
    mic="${MEETING_MIC:-$(pactl get-default-source)}"

    case "$mic" in
        "$SINK_NAME".monitor) die "default source is already $SINK_NAME.monitor — stale state?" ;;
    esac
    pactl list short sinks | grep -q "	${sink}	" || die "sink not found: $sink"

    local null l_sys l_mic
    null=$(pactl load-module module-null-sink \
        sink_name="$SINK_NAME" \
        sink_properties=device.description="Meeting mix")
    l_sys=$(pactl load-module module-loopback \
        source="${sink}.monitor" sink="$SINK_NAME" latency_msec=50)
    l_mic=$(pactl load-module module-loopback \
        source="$mic" sink="$SINK_NAME" latency_msec=50)

    printf '%s\n%s\n%s\n' "$null" "$l_sys" "$l_mic" > "$STATE"
    printf 'up: system=%s\n    mic=%s\n    capture source=%s.monitor\n' \
        "${sink}.monitor" "$mic" "$SINK_NAME"
    printf "next: 'meeting-audio watch <pattern>' in another terminal, then start recording\n"
}

cmd_attach() {
    require_up
    local pattern="${1:-}" ids moved=0 id
    [ -n "$pattern" ] || { list_candidates; die "a pattern is required (e.g. 'meetily') — refusing to move streams you did not name"; }

    ids=$(matching_streams "$pattern")
    [ -n "$ids" ] || { list_candidates; die "no capture stream matching '$pattern' (is it recording yet?)"; }

    for id in $ids; do
        pactl move-source-output "$id" "${SINK_NAME}.monitor"
        printf 'moved capture stream #%s -> %s.monitor\n' "$id" "$SINK_NAME"
        moved=$((moved + 1))
    done
    printf 'attached %d stream(s); global default source untouched (%s)\n' \
        "$moved" "$(pactl get-default-source)"
}

# Poll for the named client's capture stream and move it as soon as it appears.
# Removes the timing footgun: the stream only exists once recording starts.
cmd_watch() {
    require_up
    local pattern="${1:-}" ids id
    [ -n "$pattern" ] || { list_candidates; die "a pattern is required (e.g. 'meetily')"; }

    # Record the pid so meeting-stop can kill exactly this process. `pkill -f
    # "meeting-audio watch"` is NOT a safe substitute: it also matches any shell
    # whose command line merely mentions the string, which killed a live session
    # during testing on 2026-08-11.
    if [ -f "$WATCHPID" ] && kill -0 "$(cat "$WATCHPID")" 2>/dev/null; then
        die "a watcher is already running (pid $(cat "$WATCHPID"))"
    fi
    printf '%s\n' "$$" > "$WATCHPID"
    trap 'rm -f "$WATCHPID"' EXIT INT TERM

    printf "watching for capture streams matching '%s' (Ctrl-C to stop)\n" "$pattern"
    while :; do
        ids=$(matching_streams "$pattern" || true)
        for id in $ids; do
            if pactl move-source-output "$id" "${SINK_NAME}.monitor" 2>/dev/null; then
                printf '[%s] moved #%s -> %s.monitor\n' "$(date +%H:%M:%S)" "$id" "$SINK_NAME"
            fi
        done
        sleep 2
    done
}

cmd_status() {
    if [ -f "$STATE" ]; then
        printf 'state: UP (modules %s)\n' "$(paste -sd' ' "$STATE")"
    else
        printf 'state: down\n'
    fi
    printf 'default sink   : %s\n' "$(pactl get-default-sink)"
    printf 'default source : %s\n' "$(pactl get-default-source)"
    printf '\ncapture streams:\n'
    pactl -f json list source-outputs | jq -r \
        --argjson mix "$(mix_source_index || echo -1)" '
        .[] | "  #\(.index)  source=\(.source)  \(.properties["application.name"] // "?")" +
              (if (.source | tonumber) == $mix then "   <-- on the mix" else "" end)'
}

cmd_down() {
    require_up
    local m
    tac "$STATE" | while read -r m; do
        [ -n "$m" ] && pactl unload-module "$m" 2>/dev/null || true
    done
    rm -f "$STATE"
    printf 'down; default source = %s\n' "$(pactl get-default-source)"
    if pactl list short sinks | grep -q "$SINK_NAME"; then
        printf 'WARNING: %s sink still present\n' "$SINK_NAME"
    fi
}

case "${1:-}" in
    is-up)  [ -f "$STATE" ] ;;   # predicate for scripts: exit 0 if the mix is up
    up)     shift; cmd_up "$@" ;;
    attach) shift; cmd_attach "${1:-}" ;;
    watch)  shift; cmd_watch "${1:-}" ;;
    status) shift; cmd_status ;;
    down)   shift; cmd_down ;;
    *) cat >&2 <<EOF
usage: meeting-audio {up|watch <pattern>|attach <pattern>|status|is-up|down}

  up               create the mix (system audio + mic); does not touch the default source
  watch <pattern>  poll and move the named client's capture stream as soon as it appears
  attach <pattern> one-shot version of watch, for a client already recording
  status           show state, routing, and every live capture stream
  down             tear the mix down

The pattern is mandatory and matched against application.name, process.binary and
media.name. It exists so that a conferencing app's OWN microphone stream is never
moved onto the mix — that would send the far end back into the call.

env: MEETING_SINK (default: current default sink), MEETING_MIC (default: current default source)
EOF
        exit 2 ;;
esac
