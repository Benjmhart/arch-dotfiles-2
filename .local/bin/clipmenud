#!/bin/sh
# Wrapper: clipmenud with the settings that actually keep the vault out of it.
#
# ---------------------------------------------------------------- CM_SELECTIONS
# THIS is the line that closes the hole. Demonstrated 2026-08-25:
#
#   1. focus a window titled "...KeePassXC", copy a secret  -> correctly BLOCKED
#   2. move focus away; the secret is STILL on the clipboard
#   3. highlight anything at all, anywhere               -> the secret is RECORDED
#
# clipmenud checks the active window ONCE PER EVENT, then reads the CURRENT
# CONTENTS of every selection it watches. The ignore rule therefore protects the
# moment of the copy and nothing afterwards: for as long as the password remains
# on the clipboard -- KeePassXC's default is 10 seconds, and longer if that
# timeout is off -- the very next selection event of any kind sweeps it up.
#
# That is why CM_IGNORE_WINDOW alone was not enough, twice.
#
# Watching PRIMARY only makes the leak structurally impossible rather than
# unlikely: KeePassXC copies to CLIPBOARD, and CLIPBOARD is no longer read at all.
#
# THE COST, stated plainly: Ctrl+C history is gone. clipmenu now only remembers
# highlighted text -- which is herdr's clip-on-highlight, the use case Ben named.
# To trade that back for the leak, set CM_SELECTIONS="clipboard primary".
[ -n "$CM_SELECTIONS" ]    || CM_SELECTIONS='primary'

# Defence in depth, not the main defence. It still blocks the copy event itself,
# which keeps the secret out even of the PRIMARY path if it is ever highlighted
# inside the vault window. Title read off a live window 2026-08-24:
#   "Passwords.kdbx [Locked] - KeePassXC"
[ -n "$CM_IGNORE_WINDOW" ] || CM_IGNORE_WINDOW='[Kk]ee[Pp]ass'

# WHY A WRAPPER AND NOT JUST .xinitrc: .xinitrc runs at LOGIN only, so anyone
# starting clipmenud by hand mid-session got the packaged script with no settings
# at all. ~/.local/bin precedes /usr/bin, so this catches every start.
export CM_SELECTIONS CM_IGNORE_WINDOW
exec /usr/bin/clipmenud "$@"
