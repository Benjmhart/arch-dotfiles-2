#!/usr/bin/env python3
"""
pi-set-key — write an API key into ~/.pi/agent/auth.json without it touching
shell history, argv, or the terminal scrollback.

WHY THIS EXISTS
  beast-arch task 39. The obvious `secret-tool` route does not work on this
  box: gnome-keyring is installed but nothing ever unlocks it — there is no
  display manager (the session is startx -> exec xmonad) and pam_gnome_keyring
  is in no /etc/pam.d file, so login.keyring is locked on every boot and a
  non-interactive lookup always fails. The key therefore lives in auth.json,
  and this script is the least-bad way to put it there.

WHAT THIS DOES NOT DO
  It does not protect the key. auth.json is plaintext at 0600, so anything
  running as this user can read it — which per task 45 includes the coding
  agents. That is a deliberate, accepted trade for a rotatable API key. Do not
  use this for anything you would not put in a 0600 file.

USAGE
  pi-set-key deepseek        prompt (no echo) and store
  pi-set-key --list          show which providers have entries, never values
  pi-set-key --remove NAME   drop an entry
"""
import getpass
import json
import os
import sys
from pathlib import Path

AUTH = Path.home() / ".pi/agent/auth.json"


def load():
    return json.loads(AUTH.read_text()) if AUTH.exists() else {}


def save(d):
    AUTH.parent.mkdir(parents=True, exist_ok=True)
    # write via a 0600 temp file so the key is never briefly world-readable
    tmp = AUTH.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(d, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, AUTH)
    os.chmod(AUTH, 0o600)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0

    d = load()

    if argv[0] == "--list":
        if not d:
            print("no entries")
        for k, v in d.items():
            kind = v.get("type", "?") if isinstance(v, dict) else "?"
            print(f"  {k:<24} {kind}")
        return 0

    if argv[0] == "--remove":
        if len(argv) < 2:
            print("usage: pi-set-key --remove NAME", file=sys.stderr)
            return 2
        if d.pop(argv[1], None) is None:
            print(f"no entry for {argv[1]}")
            return 1
        save(d)
        print(f"removed {argv[1]}")
        return 0

    provider = argv[0]
    key = getpass.getpass(f"{provider} API key (not echoed): ").strip()
    if not key:
        print("empty, nothing written", file=sys.stderr)
        return 1
    d[provider] = {"type": "api_key", "key": key}
    save(d)
    print(f"stored {provider} in {AUTH} (mode 0600, {len(key)} chars)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
