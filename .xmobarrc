Config { font = "-*-Fixed-Bold-R-Normal-*-13-*-*-*-*-*-*-*"
       , bgColor = "black"
       , fgColor = "grey"
       -- Deliberately NOT `OnScreen n`: this one config is shared by TWO xmobar
       -- processes, one per monitor, and each is pointed at its screen with `-x N`
       -- on the command line in ~/.xmonad/xmonad.hs. Hardcoding OnScreen here would
       -- fight the flag. `Top` means "top of whichever screen -x selected".
       -- 2026-08-07: briefly was `OnScreen 1 Top` (single bar on the vertical
       -- monitor) before Ben clarified he wanted a bar on both.
       , position = Top
       , commands =
         [ Run Date "%a %b %_d %l:%M" "date" 10
         -- Locks prints CAPS / NUM / SCROLL only while that lock is ON, and nothing
         -- otherwise, so the bar stays quiet until it has something to say.
         , Run Locks
         , Run StdinReader
         -- What dunst is holding back, 2026-09-02 (task 58). Prints nothing
         -- unless dunst is paused or has notifications queued, so it stays as
         -- quiet as Locks does. ABSOLUTE path on purpose: xmobar is spawned by
         -- xmonad from .xinitrc, which does not source .zshrc, so ~/.local/bin
         -- is not reliably on PATH there (.xinitrc says so itself at line 130).
         -- Polls every 5s; the script exits early unless dunst is running.
         , Run Com "/home/ben/.local/bin/dunst-waiting" [] "dunstwait" 20
         ]
       , sepChar = "%"
       , alignSep = "}{"
       -- %locks% goes in the CENTRE section (between } and {), deliberately.
       -- Putting it in the right section next to the clock would push the clock
       -- leftwards every time CAPS appears, into the stalonetray icons that sit
       -- at x 1660-1788 on the LEFT monitor. The centre is empty, fixed, and hard
       -- to miss.
       --
       -- Note this config now drives two bars of DIFFERENT widths -- 1920px on
       -- HDMI-A-0, 1080px on the vertical HDMI-A-1. The tray only overlaps the
       -- left one. Anything tuned by pixel offset here is tuned for the wide bar
       -- and is tighter on the narrow one; `shorten 50` on ppTitle is the most
       -- likely thing to look cramped on the vertical monitor.
       -- %dunstwait% joins %locks% in the CENTRE for the same reason: it is
       -- normally empty, and must not shove the clock into stalonetray when it
       -- is not. It reads "PAUSED", "PAUSED N held", or "N waiting". PAUSED
       -- shows even at zero held, because the failure it guards against is
       -- forgetting to unpause after a meeting.
       , template = "%StdinReader% }<fc=#ff5555>%locks%</fc> <fc=#bd93f9>%dunstwait%</fc>{ <fc=#ee9a00>%date%</fc>"
       }
       -- wishlist
       -- 1) clickable workspaces
